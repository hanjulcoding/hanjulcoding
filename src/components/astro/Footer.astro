---
const links = [
  { href: "https://github.com/hanjulcoding/blog", text: "github" },
  { href: "https://www.youtube.com/@hanjulcoding", text: "youtube" },
  { href: "/rss.xml", text: "rss" },
];

// 정적 빌드라 여기 값은 배포 시점에 굳는다. 아래 스크립트가 열람 시점으로 고쳐준다.
const year = new Date().getFullYear();
---

<footer>
  <div class="inner">
    <div class="row">
      <a class="brand" href="https://hanjulcoding.com" target="_blank" rel="noopener noreferrer">
        hanjulcoding
        <svg
          class="icon"
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6" />
        </svg>
      </a>

      <nav class="links" aria-label="바깥 링크">
        {
          links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.text}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="copyright">© <span id="footer-year">{year}</span> 한줄코딩 · 매일매일 한 줄 씩</p>
  </div>
</footer>

{/* 해가 바뀌어도 재배포 전까지 지난 연도가 남지 않도록 보는 시점으로 덮어쓴다. */}
<script is:inline>
  document.getElementById("footer-year").textContent = new Date().getFullYear();
</script>

<style>
  footer {
    margin: 4rem 1rem 2rem;
  }

  /* 구분선과 글자 시작점을 본문 박스(max-width 1024 + padding 2rem)에 맞춘다. */
  .inner {
    max-width: 1024px;
    margin: 0 auto;
    border-top: 1px solid rgba(var(--foreground), 0.12);
    padding: 1.25rem 2rem 0;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  a.brand {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgba(var(--foreground), 0.25);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    font-family: "DungGeunMo", monospace;
    font-size: 0.85rem;
    color: rgb(var(--foreground));
    text-decoration: none;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  a.brand:hover {
    border-color: rgb(var(--foreground));
    background-color: rgb(var(--foreground));
    color: rgb(var(--background));
  }

  a.brand .icon {
    transition: transform 0.15s;
  }

  a.brand:hover .icon {
    transform: translate(1px, -1px);
  }

  .links {
    display: flex;
    gap: 1rem;
  }

  /* 밑줄을 배경으로 깔아 hover 때 좌에서 우로 그어지게 한다. */
  .links a {
    font-size: 0.8rem;
    color: rgba(var(--foreground), 0.55);
    text-decoration: none;
    background-image: linear-gradient(rgb(var(--foreground)), rgb(var(--foreground)));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    transition:
      background-size 0.2s,
      color 0.15s;
  }

  .links a:hover {
    color: rgb(var(--foreground));
    background-size: 100% 1px;
  }

  .copyright {
    margin: 0.9rem 0 0;
    font-size: 0.7rem;
    color: rgba(var(--foreground), 0.4);
  }

  /* 좁은 화면에서는 여백을 줄여 두 줄로 접히는 폭을 벌어준다. */
  @media screen and (max-width: 636px) {
    .inner {
      padding: 1.25rem 1rem 0;
    }
  }
</style>
